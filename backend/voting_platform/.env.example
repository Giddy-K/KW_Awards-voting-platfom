# Copy to `.env` (git-ignored) and fill in. Real environment variables take
# precedence over this file. Secret values below are intentionally blank.
#
# Settings module:
#   manage.py            -> voting_platform.settings.dev   (local defaults)
#   wsgi.py / asgi.py    -> voting_platform.settings.prod  (no insecure defaults)
#   pytest               -> voting_platform.settings.test
# Override with DJANGO_SETTINGS_MODULE.
#
# In dev, every variable marked "required in prod" has a safe local default and
# a blank value counts as unset, so a copy of this file works locally as-is
# (you only need DB_PASSWORD if your local Postgres has one).

# --- Core (required in prod) -------------------------------------------------
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# Dev default is True; prod default is False. Never True in production.
# DEBUG=False
# Comma-separated hostnames, no scheme. e.g. vote.example.com,api.example.com
ALLOWED_HOSTS=
# Public URL of the frontend, no trailing slash. e.g. https://vote.example.com
FRONTEND_URL=
# Comma-separated origins WITH scheme. e.g. https://vote.example.com
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Database (required in prod) --------------------------------------------
# Option A: a single URL (takes precedence if set)
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Option B: individual variables
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Cache / throttling (required in prod) ------------------------------------
# Throttle counters must live in a cache shared by all worker processes.
#   redis://HOST:6379/1  (recommended)  |  db://cache_table (then run `createcachetable`)
# Dev default is an in-process cache; prod refuses to start without a shared one.
CACHE_URL=

# --- Client IP behind a reverse proxy -----------------------------------------
# The proxy chain in front of the app: IPs or CIDRs, one per hop, outermost first, ending with
# the proxy that connects to this server (a single nginx: one entry, e.g. 10.0.0.5).
# Empty = X-Forwarded-For is ignored and the socket address is used. Configure the proxy to
# OVERWRITE X-Forwarded-For (not append). Wrong entries fail the system check.
TRUSTED_PROXIES=

# --- SMS (Africa's Talking) ------------------------------------------------------
# Required in prod. Dev falls back to printing codes on the console when these are unset.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SANDBOX=False
# SMS_BACKEND=auto            # auto | console | locmem | africastalking

# --- CAPTCHA (Cloudflare Turnstile) -----------------------------------------------
# Required in prod. Dev falls back to an always-pass CAPTCHA when unset.
TURNSTILE_SECRET_KEY=
# CAPTCHA_BACKEND=auto        # auto | dummy | turnstile

# --- Auth and OTP tuning (defaults shown) -------------------------------------------
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_HOURS=24
# VOTER_TOKEN_MINUTES=30
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5

# --- Rate limits (defaults shown; format N/Ws where W optional and s is s|m|h|d) --------
# An empty value disables that limit.
# THROTTLE_OTP_REQUEST_PHONE_SHORT=3/15m
# THROTTLE_OTP_REQUEST_PHONE_DAY=10/1d
# THROTTLE_OTP_REQUEST_IP=20/1h
# THROTTLE_OTP_VERIFY_PHONE=10/15m
# THROTTLE_OTP_VERIFY_IP=40/1h
# THROTTLE_VOTE_VOTER=30/1h
# THROTTLE_VOTE_IP=100/1h
# THROTTLE_NOMINATION_IP=5/1h
# THROTTLE_STAFF_LOGIN_IP=10/15m

# --- Uploads (defaults shown) -----------------------------------------------------------
# MAX_UPLOAD_BYTES=5242880
# IMAGE_MAX_DIMENSION=1600

# --- Email (Django admin) -----------------------------------------------------------------
# Dev default prints emails to the console. In prod the default is SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_FROM=
EMAIL_BCC=
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Use TLS (STARTTLS, usually port 587) OR SSL (usually port 465), not both.
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

# --- Production hardening (prod settings only; defaults shown) --------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=False    # opt-in: effectively irreversible, applies to all subdomains
# LOG_LEVEL=INFO
